# =============================================================================
# WheresMyMoney! Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Firefly III Connection ---
# The base URL of your Firefly III instance (no trailing slash)
FIREFLY_API_URL=http://your-firefly-instance.local
# Your Firefly III Personal Access Token
FIREFLY_TOKEN=your_personal_access_token_here

# --- Service Ports ---
# Port the backend API server listens on (host)
BACKEND_PORT=3001
# Port the frontend web server listens on (host)
FRONTEND_PORT=3000

# --- Calculation Settings ---
# The tag used to identify company transactions in Firefly III
COMPANY_TAG=MnApps
# Earliest date from which to include transactions (YYYY-MM-DD)
START_DATE=2023-01-01

# --- Tax Configuration ---
# Corporate Income Tax rate (as a decimal, e.g. 0.22 = 22%)
INCOME_TAX_RATE=0.22
# Flat Business Tax (Telos Epitidevmatos) in EUR
BUSINESS_TAX=800
# Advance Tax rate applied to CIT (as a decimal, e.g. 0.40 = 40%)
ADVANCE_TAX_RATE=0.40

# --- Firefly III Ignored Accounts ---
# Comma-separated list of account names to ignore from Firefly III calculations
IGNORE_FIREFLY_ACCOUNTS=

# --- Trading212 Integration ---
# Provide both key and secret to fetch data from Trading212
TRADING212_API_KEY=
TRADING212_API_SECRET=
# Environment: 'live' or 'demo'
TRADING212_ENV=live

# --- Database Caching ---
# How often the background worker recalculates statistics (in minutes)
STATISTICS_CACHE_TTL_MINUTES=15

# --- Projections ---
# The target financial goal in EUR (e.g. for FI/RE)
TARGET_ASSET_GOAL=1000000
# Expected annual growth rate of invested assets (e.g., 0.07 for 7%)
EXPECTED_INVESTMENT_GROWTH_RATE=0.07
# Safe Withdrawal Rate used for calculating retirement timeline (e.g., 0.04 for 4%)
SAFE_WITHDRAWAL_RATE=0.04
# Fixed monthly amount to project as invested, in addition to or instead of the full surplus
MONTHLY_INVESTMENT_AMOUNT=500
# Number of years to project into the future
PROJECTION_HORIZON_YEARS=30
